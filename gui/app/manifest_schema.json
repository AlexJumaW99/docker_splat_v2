              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Format"
        }
      },
      "required": [
        "kind",
        "original_filename",
        "size_bytes"
      ],
      "title": "SourceParams",
      "type": "object"
    },
    "TrainManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Run Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/Host"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "outputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "checksums": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Checksums",
          "type": "object"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "provenance": {
          "default": "declared",
          "enum": [
            "declared",
            "backfilled"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "stage": {
          "const": "train",
          "default": "train",
          "title": "Stage",
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "params": {
          "$ref": "#/$defs/TrainParams"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "parent",
        "params"
      ],
      "title": "TrainManifest",
      "type": "object"
    },
    "TrainParams": {
      "additionalProperties": false,
      "description": "Arguments handed to `ns-train <method>`. Captures both the live\nknobs the GUI exposes and the dataparser routing.",
      "properties": {
        "method": {
          "enum": [
            "splatfacto",
            "splatfacto-big",
            "splatfacto-mcmc",
            "splatfacto-w",
            "splatfacto-w-light"
          ],
          "title": "Method",
          "type": "string"
        },
        "experiment_name": {
          "title": "Experiment Name",
          "type": "string"
        },
        "timestamp_dir": {
          "title": "Timestamp Dir",
          "type": "string"
        },
        "max_num_iterations": {
          "minimum": 1,
          "title": "Max Num Iterations",
          "type": "integer"
        },
        "steps_per_save": {
          "minimum": 1,
          "title": "Steps Per Save",
          "type": "integer"
        },
        "vis": {
          "enum": [
            "viewer",
            "tensorboard",
            "viewer+tensorboard"
          ],
          "title": "Vis",
          "type": "string"
        },
        "viewer_websocket_host": {
          "default": "0.0.0.0",
          "title": "Viewer Websocket Host",
          "type": "string"
        },
        "viewer_quit_on_train_completion": {
          "default": false,
          "title": "Viewer Quit On Train Completion",
          "type": "boolean"
        },
        "dataparser": {
          "enum": [
            "nerfstudio-data",
            "colmap",
            "splatfactow_dataparser"
          ],
          "title": "Dataparser",
          "type": "string"
        },
        "extra_flags": {
          "items": {
            "type": "string"
          },
          "title": "Extra Flags",
          "type": "array"
        },
        "downscale_factor": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Downscale Factor"
        },
        "camera_res_scale_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Res Scale Factor"
        },
        "cache_images": {
          "anyOf": [
            {
              "enum": [
                "gpu",
                "cpu"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Images"
        },
        "steps_per_eval_image": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps Per Eval Image"
        },
        "steps_per_eval_all_images": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps Per Eval All Images"
        },
        "rasterize_mode": {
          "anyOf": [
            {
              "enum": [
                "classic",
                "antialiased"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rasterize Mode"
        },
        "max_gs_num": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Gs Num"
        }
      },
      "required": [
        "method",
        "experiment_name",
        "timestamp_dir",
        "max_num_iterations",
        "steps_per_save",
        "vis",
        "dataparser"
      ],
      "title": "TrainParams",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "export": "#/$defs/ExportManifest",
      "process": "#/$defs/ProcessManifest",
      "render": "#/$defs/RenderManifest",
      "source": "#/$defs/SourceManifest",
      "train": "#/$defs/TrainManifest"
    },
    "propertyName": "stage"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SourceManifest"
    },
    {
      "$ref": "#/$defs/ProcessManifest"
    },
    {
      "$ref": "#/$defs/TrainManifest"
    },
    {
      "$ref": "#/$defs/ExportManifest"
    },
    {
      "$ref": "#/$defs/RenderManifest"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexJumaW99/docker_splat_v2/manifest_schema/v1.0",
  "title": "docker_splat_v2 Manifest",
  "description": "Per-stage manifest for the docker_splat_v2 warehouse. Schema version 1.0. Every artifact directory (source, processed, train, export, render) contains one manifest.json validated against this schema."
}
