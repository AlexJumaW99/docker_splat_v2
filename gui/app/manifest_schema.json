    "ProcessParams": {
      "additionalProperties": false,
      "description": "The arguments handed to `ns-process-data {video|images}`. Mirrors\nthe flags the Process tab exposes.",
      "properties": {
        "mode": {
          "enum": [
            "video",
            "images"
          ],
          "title": "Mode",
          "type": "string"
        },
        "matching_method": {
          "enum": [
            "sequential",
            "vocab_tree",
            "exhaustive"
          ],
          "title": "Matching Method",
          "type": "string"
        },
        "num_frames_target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Frames Target"
        },
        "num_downscales": {
          "default": 3,
          "title": "Num Downscales",
          "type": "integer"
        },
        "camera_type": {
          "default": "perspective",
          "enum": [
            "perspective",
            "fisheye",
            "equirectangular",
            "pinhole",
            "simple_pinhole"
          ],
          "title": "Camera Type",
          "type": "string"
        },
        "refine_intrinsics": {
          "default": true,
          "title": "Refine Intrinsics",
          "type": "boolean"
        },
        "same_dimensions": {
          "default": true,
          "title": "Same Dimensions",
          "type": "boolean"
        },
        "use_gpu": {
          "default": true,
          "title": "Use Gpu",
          "type": "boolean"
        },
        "use_sfm_depth": {
          "default": false,
          "title": "Use Sfm Depth",
          "type": "boolean"
        },
        "crop_factor": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Factor"
        },
        "percent_radius_crop": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percent Radius Crop"
        },
        "images_per_equirect": {
          "anyOf": [
            {
              "enum": [
                8,
                14
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Images Per Equirect"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Random Seed"
        },
        "eval_random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Random Seed"
        },
        "eval_data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Data"
        },
        "extra_flags": {
          "items": {
            "type": "string"
          },
          "title": "Extra Flags",
          "type": "array"
        },
        "sfm_tool": {
          "anyOf": [
            {
              "enum": [
                "colmap",
                "hloc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sfm Tool"
        },
        "feature_type": {
          "anyOf": [
            {
              "enum": [
                "sift",
                "superpoint",
                "superpoint_aachen",
                "superpoint_max",
                "superpoint_inloc",
                "r2d2",
                "d2net-ss",
                "sosnet",
                "disk"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Type"
        },
        "matcher_type": {
          "anyOf": [
            {
              "enum": [
                "NN",
                "superglue",
                "superglue-fast",
                "NN-superpoint",
                "NN-ratio",
                "NN-mutual",
                "adalam",
                "disk+lightglue",
                "superpoint+lightglue"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matcher Type"
        }
      },
      "required": [
        "mode",
        "matching_method"
      ],
      "title": "ProcessParams",
      "type": "object"
    },
    "RenderManifest": {
