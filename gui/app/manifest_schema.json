{
  "$defs": {
    "ExportManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Run Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/Host"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "outputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "checksums": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Checksums",
          "type": "object"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "provenance": {
          "default": "declared",
          "enum": [
            "declared",
            "backfilled"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "stage": {
          "const": "export",
          "default": "export",
          "title": "Stage",
          "type": "string"
        },
        "parent": {
          "$ref": "#/$defs/Parent"
        },
        "params": {
          "$ref": "#/$defs/ExportParams"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "parent",
        "params"
      ],
      "title": "ExportManifest",
      "type": "object"
    },
    "ExportParams": {
      "additionalProperties": false,
      "description": "Arguments handed to `ns-export gaussian-splat` or the custom\n`ns-export-splatfactow` wrapper. For splatfacto-w runs, also captures\nwhich appearance embedding was baked into the per-gaussian SH.",
      "properties": {
        "kind": {
          "enum": [
            "splat",
            "pcd",
            "mesh"
          ],
          "title": "Kind",
          "type": "string"
        },
        "exporter": {
          "title": "Exporter",
          "type": "string"
        },
        "source_checkpoint_step": {
          "minimum": 0,
          "title": "Source Checkpoint Step",
          "type": "integer"
        },
        "appearance_embedding_strategy": {
          "anyOf": [
            {
              "enum": [
                "average_training_cameras",
                "specific_camera",
                "manual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appearance Embedding Strategy"
        },
        "appearance_embedding_camera_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appearance Embedding Camera Id"
        }
      },
      "required": [
        "kind",
        "exporter",
        "source_checkpoint_step"
      ],
      "title": "ExportParams",
      "type": "object"
    },
    "Host": {
      "additionalProperties": true,
      "description": "Reproducibility surface \u2014 captured at write time. Every field is\noptional because backfilled manifests may not have all of it, but\ndeclared (live-written) manifests should populate as much as possible.\n`extra='allow'` so callers can record extra environment without a\nschema bump.",
      "properties": {
        "hostname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os"
        },
        "gpu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu"
        },
        "cuda_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Version"
        },
        "docker_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Docker Image"
        },
        "colmap_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colmap Commit"
        },
        "nerfstudio_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nerfstudio Commit"
        },
        "gsplat_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gsplat Version"
        }
      },
      "title": "Host",
      "type": "object"
    },
    "Parent": {
      "additionalProperties": false,
      "description": "Declared lineage pointer. The `run_id` references another manifest's\ntop-level `run_id`. Stage is denormalized for cheap joins without a\nsecond lookup.",
      "properties": {
        "stage": {
          "enum": [
            "source",
            "process",
            "train",
            "export",
            "render"
          ],
          "title": "Stage",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "run_id"
      ],
      "title": "Parent",
      "type": "object"
    },
    "ProcessManifest": {
