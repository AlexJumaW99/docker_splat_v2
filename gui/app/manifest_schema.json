    "RenderParams": {
      "additionalProperties": false,
      "description": "Arguments handed to `ns-render camera-path`. The camera path JSON\nitself lives under the processed run's `camera_paths/` dir; we record\nthe relpath so the render can be reproduced.",
      "properties": {
        "camera_path_filename": {
          "title": "Camera Path Filename",
          "type": "string"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "resolution_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Width"
        },
        "resolution_height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Height"
        },
        "frame_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
